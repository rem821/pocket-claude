# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# ---------------------------------------------------------------- required

# Shared secret you type once on each device. Generate one with:
#   openssl rand -hex 24
# Anyone on your tailnet who has this gets shell-equivalent access to this
# machine through Claude. Treat it like an SSH key.
POCKET_TOKEN=

# The folder that holds your project directories. Every subdirectory becomes a
# project in the UI. Defaults to ~/projects if unset.
PROJECTS_ROOT=/home/you/projects

# ---------------------------------------------------------------- network

# Address to bind.
#   auto        ask Tailscale for this machine's tailnet IP (recommended)
#   127.0.0.1   loopback only — use with an SSH tunnel or a reverse proxy
#   0.0.0.0     every interface, including your LAN. Only if you mean it.
#
# Binding the tailnet address specifically keeps the server off your LAN and
# Wi-Fi interfaces entirely.
HOST=auto

PORT=7420

# ---------------------------------------------------------------- optional

# Where Claude Code keeps its transcripts. Defaults to ~/.claude.
# CLAUDE_HOME=/home/you/.claude

# The claude binary to run. Auto-detected from PATH and the usual install
# locations; set it only if detection picks the wrong one.
# CLAUDE_BIN=/home/you/.local/bin/claude

# Also list projects that have Claude Code history but live outside
# PROJECTS_ROOT. Off by default so PROJECTS_ROOT means what it says.
# INCLUDE_EXTERNAL_HISTORY=true

# ---------------------------------------------------------------- limits

# Concurrent conversations. Each one is a claude subprocess, so this bounds
# memory use. Idle ones are evicted before the limit is enforced.
# MAX_RUNNERS=8

# Total bytes of uploads kept per project. Oldest files are pruned first.
# UPLOAD_QUOTA_BYTES=268435456

# ---------------------------------------------------------------- hardening

# Browser origins allowed to open the WebSocket or POST, comma-separated.
# Same-origin is always allowed, so leave this empty unless you front the app
# with a reverse proxy on a different hostname.
# ALLOWED_ORIGINS=https://pocket.example.ts.net

# Add the Secure flag to the session cookie. Set this when serving over HTTPS
# (e.g. behind `tailscale serve`); leave it off for plain HTTP or the cookie
# will be rejected by the browser.
# COOKIE_SECURE=true

# Server log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
